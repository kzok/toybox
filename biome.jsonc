{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    // the detection from dependencies misses the workspaces, whose package.json lists no react.
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        // enable interaction with SVG elements
        "noStaticElementInteractions": "off"
      },
      "style": {
        "useNodejsImportProtocol": "error",
        // allow non-null assertion
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    // override for the canvas overlay, which is driven by pointer events alone
    {
      "includes": ["app/ss-edit/src/containers/EditorPane/**"],
      "linter": {
        "rules": {
          "a11y": {
            // the overlay items are presentational: they offer no keyboard interaction on purpose.
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    // override for test files
    {
      "includes": ["**/__tests__/**", "e2e/**"],
      "linter": {
        "rules": {
          "a11y": {
            "preset": "none"
          }
        }
      }
    }
  ]
}
